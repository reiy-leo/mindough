{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口、小窗（mini）与设置窗口（settings）的权限。opener 除了默认的 http(s)/mailto/tel，还放行别的 App 的链接（codex:// obsidian:// …），挡掉的协议和 src/lib/link-scheme.ts 的 BLOCKED_SCHEMES 一致",
  "windows": [
    "main",
    "mini",
    "settings"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "*:*"
        }
      ],
      "deny": [
        {
          "url": "javascript:*"
        },
        {
          "url": "vbscript:*"
        },
        {
          "url": "data:*"
        },
        {
          "url": "file:*"
        },
        {
          "url": "blob:*"
        },
        {
          "url": "filesystem:*"
        },
        {
          "url": "about:*"
        },
        {
          "url": "view-source:*"
        },
        {
          "url": "chrome:*"
        },
        {
          "url": "chrome-extension:*"
        },
        {
          "url": "resource:*"
        },
        {
          "url": "jar:*"
        },
        {
          "url": "tauri:*"
        },
        {
          "url": "asset:*"
        },
        {
          "url": "ipc:*"
        }
      ]
    },
    "deep-link:default",
    "notification:default",
    "dialog:allow-save",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-unminimize",
    "core:window:allow-set-title"
  ]
}
